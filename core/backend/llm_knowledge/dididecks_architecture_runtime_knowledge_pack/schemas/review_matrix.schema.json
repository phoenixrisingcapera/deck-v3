{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ReviewMatrix",
  "type": "object",
  "required": [
    "deck_id",
    "variants",
    "slides"
  ],
  "properties": {
    "deck_id": {
      "type": "string"
    },
    "variants": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "enum": [
          "scroll",
          "play",
          "print",
          "thumbnail",
          "editor"
        ]
      }
    }
  }
}
