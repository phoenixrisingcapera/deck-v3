{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DeckAccessAndSharing",
  "type": "object",
  "required": [
    "deck_id",
    "access_mode",
    "members",
    "share_links"
  ],
  "properties": {
    "deck_id": {
      "type": "string"
    },
    "access_mode": {
      "enum": [
        "private",
        "organisation",
        "share_link"
      ]
    },
    "members": {
      "type": "array"
    },
    "share_links": {
      "type": "array"
    },
    "access_events": {
      "type": "array"
    },
    "permissions": {
      "type": "object"
    }
  }
}
