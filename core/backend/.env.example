APP_NAME="Deck API"
APP_ENV="production"
PORT="8080"

# Browser/frontend origins allowed to call the API.
ALLOWED_ORIGINS="https://deck.aistack.codes,https://www.deck.aistack.codes"
CORS_ORIGIN="https://deck.aistack.codes"

# Database
DATABASE_URL=""
AI_DATABASE_URL=""

# Auth
AUTH_SECRET_KEY=""
AUTH_SECRET_KEY_ID="prod-auth-v1"
AUTH_TOKEN_EXPIRY_MINUTES="60"
PUBLIC_SIGNUP_ENABLED="true"
USER_ADMIN_BOOTSTRAP_TOKEN=""

# Workspace AI provider key encryption.
WORKSPACE_AI_FERNET_KEY=""
WORKSPACE_AI_FERNET_KEY_VERSION="prod-fernet-v1"

# Instant HTML is disabled by default. The preview-render service receives only
# the dedicated render key, never WORKSPACE_AI_FERNET_KEY or provider keys.
INSTANT_HTML_ENABLED="false"
INSTANT_HTML_RENDERER_ORIGIN=""
INSTANT_HTML_RENDER_PARENT_ORIGIN=""
# Comma-separated exact/base hosts only for a non-standard S3/Supabase endpoint.
INSTANT_HTML_STORAGE_ALLOWED_HOSTS=""
INSTANT_HTML_CAPABILITY_TTL_SECONDS="30"
INSTANT_HTML_RENDER_FERNET_KEY=""
INSTANT_HTML_RENDER_KEY_VERSION="prod-instant-render-v1"
# Emergency historical-checkpoint recovery is off by default. Keep the ticket
# blank except during one approved, audited operation; clear it immediately after.
INSTANT_HTML_LEGACY_RECOVERY_ENABLED="false"
INSTANT_HTML_LEGACY_RECOVERY_TICKET_ID=""

# Upload/artifact storage.
DECK_AISTACK_STORAGE_PROVIDER="s3"
UPLOAD_STORAGE_BACKEND="s3"
UPLOADS_ROOT="/tmp/deck_uploads"
MAX_REQUEST_BODY_SIZE_BYTES="220200960"
UPLOAD_SECURITY_SCAN_COMMAND=""
UPLOAD_SECURITY_SCAN_TIMEOUT_SECONDS="30"
S3_BUCKET_NAME=""
AWS_S3_BUCKET_NAME=""
UPLOAD_STORAGE_S3_BUCKET=""
RAILWAY_BUCKET_NAME=""
AWS_DEFAULT_REGION=""
UPLOAD_STORAGE_S3_REGION=""
RAILWAY_BUCKET_REGION=""
AWS_ENDPOINT_URL=""
UPLOAD_STORAGE_S3_ENDPOINT=""
RAILWAY_BUCKET_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
UPLOAD_STORAGE_S3_ACCESS_KEY=""
RAILWAY_BUCKET_ACCESS_KEY=""
AWS_SECRET_ACCESS_KEY=""
UPLOAD_STORAGE_S3_SECRET_KEY=""
RAILWAY_BUCKET_SECRET_KEY=""

# ── AI providers ────────────────────────────────────────────────────
# OpenAI is the active default; Qwen remains available when explicitly selected.
# Optional Qwen/DashScope configuration for explicitly selected Qwen features.
QWEN_API_KEY=""
QWEN_MODEL="qwen-plus-2025-07-28"
QWEN_MAX_TOKENS="8192"
QWEN_TIMEOUT_SECONDS="90"
# International endpoint (default). Use https://dashscope.aliyuncs.com/compatible-mode/v1 for China.
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
DASHSCOPE_WORKSPACE_ID=""

# OpenAI is the default text-generation provider. Qwen strategy variables are
# retained for explicitly selected Qwen vision/OCR or future fallback work.
DECK_LLM_PROVIDER="openai"
DECK_LLM_STRATEGY="qwen_native"
QWEN_CRITIQUE_MODEL="qwen-plus-2025-07-28"
QWEN_REPAIR_MODEL="qwen-plus-2025-07-28"
QWEN_EMBEDDING_MODEL="text-embedding-v3"
QWEN_VISION_MODEL="qwen-vl-ocr-2025-11-20"
DECK_PREVIEW_PARALLELISM=4
QWEN_TEMPERATURE="0.3"
QWEN_MAX_RETRIES="2"
QWEN_MAX_OUTPUT_TOKENS="8192"
QWEN_FALLBACK_PROVIDER=""
QWEN_FALLBACK_MODEL=""
QWEN_MAX_TOKENS_PER_JOB="1000000"
QWEN_MAX_TOKENS_PER_WORKSPACE_DAY="1000000"
QWEN_MAX_REPAIR_ATTEMPTS="1"

# Embedding (OpenAI, projected to the existing 1024-dimensional vector store)
EMBEDDING_PROVIDER="openai"
EMBEDDING_MODEL="text-embedding-3-small"
EMBEDDING_DIMENSIONS="1024"
EMBEDDING_TIMEOUT_SECONDS="45"

# Generation mode: OpenAI is the production default.
DECK_GENERATION_MODE="openai"
AI_DAILY_GENERATION_QUOTA="1000000"

# Required on the API and every worker that performs LLM work.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5-2025-08-07"
OPENAI_TIMEOUT_SECONDS="120"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openai/gpt-4o"
OPENROUTER_TIMEOUT_SECONDS="60"
OPENROUTER_SITE_URL="https://deck.aistack.codes"
OPENROUTER_APP_NAME="deck.aistack.codes"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
ANTHROPIC_MAX_TOKENS="4096"
ANTHROPIC_TIMEOUT_SECONDS="60"
ANTHROPIC_MAX_RETRIES="1"
ANTHROPIC_RETRY_DELAY_SECONDS="0.25"

# Guardrails / observability / bot protection
SUPERADMIN_AISTACK_URL=""
SUPERADMIN_AISTACK_TIMEOUT_SECONDS="2.5"
SUPERADMIN_GUARDRAILS_URL=""
SUPERADMIN_GUARDRAILS_API_KEY=""
TURNSTILE_SECRET_KEY=""
OTEL_ENABLED=false

# Railway sets this automatically; leave blank locally.
RAILWAY_ENVIRONMENT=""
RUN_MIGRATIONS_ON_STARTUP="false"
ALLOW_MIGRATION_FAILURE_ON_STARTUP="true"
LOG_LEVEL="INFO"
