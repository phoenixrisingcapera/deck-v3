    "ArtDirectionSpec": {
      "additionalProperties": false,
      "properties": {
        "concept": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Concept",
          "type": "string"
        },
        "display_strategy": {
          "enum": [
            "serif_contrast",
            "grotesk_monument",
            "humanist",
            "condensed",
            "mono_technical"
          ],
          "title": "Display Strategy",
          "type": "string"
        },
        "ink_role": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Ink Role",
          "type": "string"
        },
        "motif": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Motif",
          "type": "string"
        },
        "paper_role": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Paper Role",
          "type": "string"
        },
        "rhythm": {
          "enum": [
            "dark_dominant",
            "light_dominant",
            "alternating",
            "tonal_progression",
            "chaptered"
          ],
          "title": "Rhythm",
          "type": "string"
        },
        "signature_role": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Signature Role",
          "type": "string"
        },
        "support_roles": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "title": "Support Roles",
          "type": "array"
        },
        "tone": {
          "enum": [
            "editorial",
            "austere",
            "technical",
            "human",
            "bold",
            "atmospheric",
            "playful",
            "luxury"
          ],
          "title": "Tone",
          "type": "string"
        }
      },
      "required": [
        "concept",
        "tone",
        "display_strategy",
        "motif",
        "rhythm",
        "paper_role",
        "ink_role",
        "signature_role",
        "support_roles"
      ],
      "title": "ArtDirectionSpec",
      "type": "object"
    },
    "CompositionSpec": {
      "additionalProperties": false,
      "properties": {
        "accent_role": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Accent Role",
          "type": "string"
        },
        "background_role": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Background Role",
          "type": "string"
        },
        "density": {
          "enum": [
            "sparse",
            "balanced",
            "dense"
          ],
          "title": "Density",
          "type": "string"
        },
        "focal_alignment": {
          "enum": [
            "left",
            "center",
            "right",
            "distributed"
          ],
          "title": "Focal Alignment",
          "type": "string"
        },
        "maximum_text_area": {
          "maximum": 0.7,
          "minimum": 0.2,
          "title": "Maximum Text Area",
          "type": "number"
        },
        "primitive": {
          "$ref": "#/$defs/SlideArchetype"
        },
        "variant": {
          "$ref": "#/$defs/CompositionVariant"
        },
        "visual_weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Visual Weight",
          "type": "number"
        }
      },
      "required": [
        "primitive",
        "variant",
        "background_role",
        "accent_role",
        "density",
        "focal_alignment",
        "visual_weight",
        "maximum_text_area"
      ],
      "title": "CompositionSpec",
      "type": "object"
    },
    "CompositionVariant": {
      "enum": [
        "left_focal",
        "right_focal",
        "centered_monument",
        "split_40_60",
        "split_60_40",
        "edge_to_edge",
        "diagonal_flow",
        "radial",
        "orbit",
        "stacked",
        "strip",
        "field"
      ],
      "title": "CompositionVariant",
      "type": "string"
    },
    "CopyBlock": {
      "additionalProperties": false,
      "properties": {
        "emphasis": {
          "enum": [
            "primary",
            "secondary",
            "quiet"
          ],
