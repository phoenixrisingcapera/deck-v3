  "$id": "https://deck.aistack.codes/schemas/deck-spec.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "art_direction": {
      "$ref": "#/$defs/ArtDirectionSpec"
    },
    "audience": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Audience",
      "type": "string"
    },
    "compiler_version": {
      "const": "instant-deck-composition-compiler.v1",
      "title": "Compiler Version",
      "type": "string"
    },
    "deck_thesis": {
      "maxLength": 220,
      "minLength": 1,
      "title": "Deck Thesis",
      "type": "string"
    },
    "deck_title": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Deck Title",
      "type": "string"
    },
    "narrative": {
      "$ref": "#/$defs/NarrativeSpec"
    },
    "schema_version": {
      "const": "deck_spec.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "slides": {
      "items": {
        "$ref": "#/$defs/SlideSpec"
      },
      "maxItems": 18,
      "minItems": 6,
      "title": "Slides",
      "type": "array"
    },
    "source_checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Checksum",
      "type": "string"
    },
    "source_package_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "Source Package Id",
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "compiler_version",
    "source_package_id",
    "source_checksum",
    "deck_title",
    "deck_thesis",
    "audience",
    "narrative",
    "art_direction",
    "slides"
  ],
  "title": "DeckSpec",
  "type": "object"
}
