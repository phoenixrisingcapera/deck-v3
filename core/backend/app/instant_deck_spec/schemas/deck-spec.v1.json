      "required": [
        "slide_id",
        "position",
        "archetype",
        "purpose",
        "headline",
        "subhead",
        "copy_blocks",
        "evidence_refs",
        "source_slide_ids",
        "omitted_source_slide_ids",
        "asset_refs",
        "composition",
        "visual"
