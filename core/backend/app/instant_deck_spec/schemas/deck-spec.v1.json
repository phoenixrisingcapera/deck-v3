          "title": "Omitted Source Slide Ids",
          "type": "array"
        },
        "opening_move": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Opening Move",
          "type": "string"
        },
        "represented_source_slide_ids": {
          "items": {
            "type": "string"
