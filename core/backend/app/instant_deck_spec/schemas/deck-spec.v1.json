        "source_slide_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Slide Ids",
          "type": "array"
        },
        "subhead": {
          "anyOf": [
            {
              "maxLength": 180,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Subhead"
        },
        "visual": {
          "$ref": "#/$defs/VisualSpec"
        }
