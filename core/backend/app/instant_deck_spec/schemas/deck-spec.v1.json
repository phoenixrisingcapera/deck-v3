    "NarrativeSpec": {
      "additionalProperties": false,
      "properties": {
        "arc": {
          "items": {
            "enum": [
              "identity",
              "proposition",
              "problem",
              "insight",
              "solution",
              "product_system",
              "proof",
              "traction",
              "business_model",
              "market",
              "go_to_market",
              "team",
              "partnerships",
              "capital_plan",
              "decision"
