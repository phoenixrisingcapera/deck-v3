{
  "$defs": {
    "BrandRoleRecord": {
      "additionalProperties": false,
      "properties": {
        "colour": {
          "pattern": "^#[0-9A-Fa-f]{6}$",
          "title": "Colour",
          "type": "string"
        },
        "provenance": {
          "enum": [
            "source_observed",
            "source_confirmed"
          ],
          "title": "Provenance",
          "type": "string"
        },
        "role_id": {
          "pattern": "^brand_[a-z0-9_]+$",
          "title": "Role Id",
          "type": "string"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 500,
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        }
      },
      "required": [
        "role_id",
        "colour",
        "provenance",
        "source_reference_ids"
      ],
      "title": "BrandRoleRecord",
      "type": "object"
    },
    "DebrisExclusion": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "ocr_debris",
            "page_counter",
            "duplicate_reference",
            "decorative_only"
          ],
          "title": "Reason",
          "type": "string"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 20,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "source_slide_id": {
          "title": "Source Slide Id",
          "type": "string"
        }
      },
      "required": [
        "source_slide_id",
        "reason"
      ],
      "title": "DebrisExclusion",
      "type": "object"
    },
    "MissingEvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "topic": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "detail"
      ],
      "title": "MissingEvidenceRecord",
      "type": "object"
    },
    "SourceAssetRecord": {
      "additionalProperties": false,
      "properties": {
        "alt_text": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Alt Text",
          "type": "string"
        },
        "asset_id": {
          "pattern": "^asset_s[0-9]{2}_[0-9]{2}$",
          "title": "Asset Id",
          "type": "string"
        },
        "asset_type": {
          "enum": [
            "embedded_image",
            "page_render",
            "logo",
            "portrait",
            "diagram"
          ],
          "title": "Asset Type",
          "type": "string"
        },
        "height": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Height",
          "type": "integer"
        },
        "mime_type": {
          "enum": [
            "image/png",
            "image/jpeg",
            "image/webp",
            "image/svg+xml"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "width": {
          "exclusiveMinimum": 0,
          "maximum": 20000,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "asset_id",
        "asset_type",
        "mime_type",
        "sha256",
        "width",
        "height",
        "alt_text",
        "source_reference_ids"
      ],
      "title": "SourceAssetRecord",
      "type": "object"
    },
    "SourceBackedBrandMetadata": {
      "additionalProperties": false,
      "properties": {
        "audience_candidate": {
          "maxLength": 180,
          "minLength": 1,
          "title": "Audience Candidate",
          "type": "string"
        },
        "audience_source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Audience Source Reference Ids",
          "type": "array"
        },
        "deck_type_candidate": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Deck Type Candidate",
          "type": "string"
        },
        "deck_type_source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Deck Type Source Reference Ids",
          "type": "array"
        },
        "logo_asset_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Asset Id"
        },
        "organization_name": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Organization Name",
          "type": "string"
        },
        "organization_source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Organization Source Reference Ids",
          "type": "array"
        },
        "product_candidate": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Product Candidate",
          "type": "string"
        },
        "product_source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Product Source Reference Ids",
          "type": "array"
        },
        "roles": {
          "items": {
            "$ref": "#/$defs/BrandRoleRecord"
          },
          "maxItems": 8,
          "minItems": 3,
          "title": "Roles",
          "type": "array"
        }
      },
      "required": [
        "organization_name",
        "organization_source_reference_ids",
        "product_candidate",
        "product_source_reference_ids",
        "audience_candidate",
        "audience_source_reference_ids",
        "deck_type_candidate",
        "deck_type_source_reference_ids",
        "roles"
      ],
      "title": "SourceBackedBrandMetadata",
      "type": "object"
    },
    "SourceClaimRecord": {
      "additionalProperties": false,
      "properties": {
        "claim_id": {
          "pattern": "^claim_s[0-9]{2}_[0-9]{2}$",
          "title": "Claim Id",
          "type": "string"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Fact Ids",
          "type": "array"
        },
        "material": {
          "default": true,
          "title": "Material",
          "type": "boolean"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "text",
        "fact_ids",
        "source_reference_ids"
      ],
      "title": "SourceClaimRecord",
      "type": "object"
    },
    "SourceConflictRecord": {
      "additionalProperties": false,
      "properties": {
        "detail": {
          "maxLength": 240,
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        },
        "evidence_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "minItems": 2,
          "title": "Evidence Ids",
          "type": "array"
        },
        "topic": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Topic",
          "type": "string"
        }
      },
      "required": [
        "topic",
        "evidence_ids",
        "detail"
      ],
      "title": "SourceConflictRecord",
      "type": "object"
    },
    "SourceEmbeddingPolicy": {
      "additionalProperties": false,
      "properties": {
        "embedding_action": {
          "const": "none",
          "default": "none",
          "title": "Embedding Action",
          "type": "string"
        },
        "global_knowledge_eligible": {
          "const": false,
          "default": false,
          "title": "Global Knowledge Eligible",
          "type": "boolean"
        },
        "scope": {
          "const": "request_data_only",
          "default": "request_data_only",
          "title": "Scope",
          "type": "string"
        }
      },
      "title": "SourceEmbeddingPolicy",
      "type": "object"
    },
    "SourceFactRecord": {
      "additionalProperties": false,
      "properties": {
        "fact_id": {
          "pattern": "^fact_s[0-9]{2}_[0-9]{2}$",
          "title": "Fact Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "identity",
            "positioning",
            "product",
            "process",
            "metric",
            "financial",
            "team",
            "partnership",
            "general"
          ],
          "title": "Kind",
          "type": "string"
        },
        "material": {
          "default": true,
          "title": "Material",
          "type": "boolean"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "text": {
          "maxLength": 2400,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "fact_id",
        "kind",
        "text",
        "source_reference_ids"
      ],
      "title": "SourceFactRecord",
      "type": "object"
    },
    "SourceFileIdentity": {
      "additionalProperties": false,
      "properties": {
        "byte_size": {
          "exclusiveMinimum": 0,
          "title": "Byte Size",
          "type": "integer"
        },
        "extraction_id": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extraction Id",
          "type": "string"
        },
        "extractor_version": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Extractor Version",
          "type": "string"
        },
        "filename": {
          "maxLength": 255,
          "minLength": 1,
          "title": "Filename",
          "type": "string"
        },
        "mime_type": {
          "enum": [
            "application/pdf",
            "application/vnd.openxmlformats-officedocument.presentationml.presentation"
          ],
          "title": "Mime Type",
          "type": "string"
        },
        "page_count": {
          "maximum": 500,
          "minimum": 1,
          "title": "Page Count",
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "mime_type",
        "byte_size",
        "page_count",
        "extraction_id",
        "extractor_version"
      ],
      "title": "SourceFileIdentity",
      "type": "object"
    },
    "SourceNumberRecord": {
      "additionalProperties": false,
      "properties": {
        "exact_text": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Exact Text",
          "type": "string"
        },
        "normalized_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalized Value"
        },
        "number_id": {
          "pattern": "^num_s[0-9]{2}_[0-9]{2}$",
          "title": "Number Id",
          "type": "string"
        },
        "qualifier": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Qualifier"
        },
        "source_reference_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Source Reference Ids",
          "type": "array"
        },
        "unit": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "number_id",
        "exact_text",
        "source_reference_ids"
      ],
      "title": "SourceNumberRecord",
      "type": "object"
    },
    "SourceReference": {
      "additionalProperties": false,
      "properties": {
        "block_index": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Block Index"
        },
        "kind": {
          "enum": [
            "slide",
            "block",
            "asset"
          ],
          "title": "Kind",
          "type": "string"
        },
        "quoted_text": {
          "anyOf": [
            {
              "maxLength": 2400,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quoted Text"
        },
        "reference_id": {
          "pattern": "^ref_s[0-9]{2}_(?:slide|b[0-9]{2}|a[0-9]{2})$",
          "title": "Reference Id",
          "type": "string"
        },
        "source_slide_id": {
          "pattern": "^src_s[0-9]{2}$",
          "title": "Source Slide Id",
          "type": "string"
        }
      },
      "required": [
        "reference_id",
        "source_slide_id",
        "kind"
      ],
      "title": "SourceReference",
      "type": "object"
    },
    "SourceSlideRecord": {
      "additionalProperties": false,
      "properties": {
        "asset_ids": {
          "items": {
            "type": "string"
          },
          "title": "Asset Ids",
          "type": "array"
        },
        "claim_ids": {
          "items": {
            "type": "string"
          },
          "title": "Claim Ids",
          "type": "array"
        },
        "fact_ids": {
          "items": {
            "type": "string"
          },
          "title": "Fact Ids",
          "type": "array"
        },
        "normalized_text": {
          "maxLength": 8000,
          "title": "Normalized Text",
          "type": "string"
        },
        "number_ids": {
          "items": {
            "type": "string"
          },
          "title": "Number Ids",
          "type": "array"
        },
        "omission_eligible": {
          "default": false,
          "title": "Omission Eligible",
          "type": "boolean"
        },
        "omission_reason": {
          "anyOf": [
            {
              "maxLength": 180,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Omission Reason"
        },
        "position": {
          "maximum": 500,
          "minimum": 1,
          "title": "Position",
          "type": "integer"
        },
        "source_page_number": {
          "maximum": 500,
          "minimum": 1,
          "title": "Source Page Number",
          "type": "integer"
        },
        "source_slide_id": {
          "pattern": "^src_s[0-9]{2}$",
          "title": "Source Slide Id",
          "type": "string"
        },
        "title": {
          "maxLength": 500,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "source_slide_id",
        "position",
        "source_page_number",
        "title",
        "normalized_text"
      ],
      "title": "SourceSlideRecord",
      "type": "object"
    }
  },
  "$id": "https://deck.aistack.codes/schemas/instant-deck-source-package.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assets": {
      "items": {
        "$ref": "#/$defs/SourceAssetRecord"
      },
      "title": "Assets",
      "type": "array"
    },
    "brand": {
      "$ref": "#/$defs/SourceBackedBrandMetadata"
    },
    "claims": {
      "items": {
        "$ref": "#/$defs/SourceClaimRecord"
      },
      "minItems": 1,
      "title": "Claims",
      "type": "array"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/SourceConflictRecord"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "debris_exclusions": {
      "items": {
        "$ref": "#/$defs/DebrisExclusion"
      },
      "title": "Debris Exclusions",
      "type": "array"
    },
    "embedding_policy": {
      "$ref": "#/$defs/SourceEmbeddingPolicy"
    },
    "facts": {
      "items": {
        "$ref": "#/$defs/SourceFactRecord"
      },
      "minItems": 1,
      "title": "Facts",
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "$ref": "#/$defs/MissingEvidenceRecord"
      },
      "title": "Missing Evidence",
      "type": "array"
    },
    "numbers": {
      "items": {
        "$ref": "#/$defs/SourceNumberRecord"
      },
      "title": "Numbers",
      "type": "array"
    },
    "package_id": {
      "pattern": "^srcpkg_[a-f0-9]{16}$",
      "title": "Package Id",
      "type": "string"
    },
    "schema_version": {
      "const": "instant-deck-source-package.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_checksum": {
      "pattern": "^[a-f0-9]{64}$",
      "title": "Source Checksum",
      "type": "string"
    },
    "source_file": {
      "$ref": "#/$defs/SourceFileIdentity"
    },
    "source_references": {
      "items": {
        "$ref": "#/$defs/SourceReference"
      },
      "minItems": 1,
      "title": "Source References",
      "type": "array"
    },
    "source_slides": {
      "items": {
        "$ref": "#/$defs/SourceSlideRecord"
      },
      "maxItems": 500,
      "minItems": 1,
      "title": "Source Slides",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "package_id",
    "source_checksum",
    "source_file",
    "source_slides",
    "source_references",
    "facts",
    "claims",
    "brand"
  ],
  "title": "NormalizedSourcePackage",
  "type": "object"
}
