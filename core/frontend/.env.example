# Server-only backend settings
# Canonical source of truth for backend origin:
# DECK_AISTACK_BACKEND_URL
# The resolver lives in src/lib/server/backendUrl.ts.
# Do not introduce new backend URL env vars in app code.
DECK_AISTACK_BACKEND_URL=https://api.deck.aistack.codes
DECK_AISTACK_CREDENTIAL_SECRET=
AUTH_SECRET_KEY=

# Exact cookieless HTML renderer origin used by capability URLs and CSP.
# Origin only: HTTPS, no path/query/credentials. Missing/invalid values fail closed.
INSTANT_HTML_RENDERER_ORIGIN=https://render.deck.aistack.codes
# Explicit browser-visible rollout gate. Omit/false fails closed with truthful UI.
PUBLIC_INSTANT_HTML_ENABLED=false

# DISABLED FOR NOW: compatibility aliases / direct-browser backend mode.
# Re-enable only if you intentionally expand beyond the current proxy-based
# product deployment.
BACKEND_URL=
API_BASE_URL=
PUBLIC_API_BASE_URL=
DECK_BACKEND_URL=
PUBLIC_DECK_AISTACK_BACKEND_URL=
