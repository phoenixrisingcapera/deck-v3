{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RebuildJob",
  "type": "object",
  "required": [
    "id",
    "deck_id",
    "status",
    "rebuild_scope"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "deck_id": {
      "type": "string"
    },
    "change_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "rebuild_scope": {
      "enum": [
        "field_only",
        "affected_slides",
        "full_deck",
        "exports_only"
      ]
    },
    "total_slides": {
      "type": "integer"
    },
    "processed_slides": {
      "type": "integer"
    },
    "items": {
      "type": "array"
    }
  }
}
