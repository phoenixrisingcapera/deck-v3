    {
      "id": "traction",
      "canonical_names": [
        "Traction",
        "Progress",
        "Metrics",
        "Momentum"
      ],
      "non_title_signals": [
        "MRR/ARR",
        "active users",
        "retention",
        "waitlist",
        "pilots",
        "LOIs",
        "growth chart",
        "customer logos",
        "usage metric"
      ],
      "common_block_roles": [
        "revenue_metric",
        "usage_metric",
        "growth_rate",
        "customer_logo",
        "pilot",
        "retention_metric",
        "pipeline_metric"
      ],
      "investor_question": "Is there evidence of demand and momentum?",
      "rewrite_goal": "Prioritise the strongest proof of pull, growth, retention, or revenue."
