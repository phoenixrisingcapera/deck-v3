{
  "version": "1.0.0",
  "description": "Investor and entrepreneurial pitch slide archetypes for semantic classification even when titles are non-standard.",
  "archetypes": [
    {
      "id": "cover",
      "canonical_names": [
        "Cover",
        "Title",
        "Opening",
        "Intro"
      ],
      "non_title_signals": [
        "company logo prominent",
        "one-line tagline",
        "date or presenter name",
        "little body text",
        "large brand lockup"
      ],
      "common_block_roles": [
        "company_name",
        "tagline",
        "presenter",
        "date",
        "logo",
        "visual_anchor"
      ],
      "investor_question": "What is this company and why should I pay attention?",
      "rewrite_goal": "Make the positioning crisp, category clear, and memorable."
    },
    {
      "id": "one_liner",
      "canonical_names": [
        "One-liner",
        "Elevator pitch",
        "What we do",
        "Company snapshot"
      ],
      "non_title_signals": [
        "single sentence describing company",
        "combines customer + product + outcome",
        "often uses 'for X who need Y' pattern",
        "mentions category creation"
      ],
      "common_block_roles": [
        "positioning_statement",
        "customer_segment",
        "product_descriptor",
        "outcome_claim",
        "category_label"
      ],
      "investor_question": "Can I understand the business in under 10 seconds?",
      "rewrite_goal": "Clarify customer, use case, product, and business category."
    },
    {
      "id": "problem",
      "canonical_names": [
        "Problem",
        "Pain",
        "Why now",
        "Current pain",
        "Challenge"
      ],
      "non_title_signals": [
        "negative current-state language",
        "manual workarounds",
        "cost/time/friction claims",
        "complaints from users",
        "unmet need",
        "broken workflow"
      ],
      "common_block_roles": [
        "problem_statement",
        "pain_point",
        "current_workaround",
        "cost_of_inaction",
        "affected_user",
        "evidence_snippet"
      ],
      "investor_question": "Is this pain real, urgent, frequent, and expensive?",
      "rewrite_goal": "Make the pain concrete, specific, and economically meaningful."
    },
    {
      "id": "customer_insight",
      "canonical_names": [
        "Insight",
        "Customer insight",
        "User behaviour",
        "Discovery"
      ],
      "non_title_signals": [
        "qualitative quotes",
        "unexpected behaviour",
        "founder learned X",
        "interview count",
        "workflow observation",
        "before/after insight"
      ],
      "common_block_roles": [
        "customer_quote",
        "observed_behavior",
        "latent_need",
        "insight_claim",
        "research_sample"
      ],
      "investor_question": "What does the founder know that others have missed?",
      "rewrite_goal": "Expose the non-obvious insight behind the product."
    },
    {
      "id": "solution",
      "canonical_names": [
        "Solution",
        "Product",
        "What we built",
        "Platform"
      ],
      "non_title_signals": [
        "product capabilities",
        "screenshots",
        "workflow steps",
        "feature clusters",
        "benefit statements",
        "'we enable' language"
      ],
      "common_block_roles": [
        "solution_summary",
        "feature",
        "benefit",
        "workflow_step",
        "screenshot",
        "capability_cluster"
      ],
      "investor_question": "How does the product solve the pain better than alternatives?",
      "rewrite_goal": "Connect features to outcomes and pain relief."
    },
    {
      "id": "product_demo",
      "canonical_names": [
        "Demo",
        "Product walkthrough",
        "How it works",
        "Workflow"
      ],
      "non_title_signals": [
        "numbered steps",
        "UI screenshots",
        "arrows between screens",
        "input-output flow",
        "before/after artefacts"
      ],
      "common_block_roles": [
        "input",
        "process_step",
        "ai_action",
        "user_action",
        "output",
        "screenshot_annotation"
      ],
      "investor_question": "Can I see the product experience and understand the magic moment?",
      "rewrite_goal": "Show the product flow with minimal words and clear value moments."
    },
    {
      "id": "value_proposition",
      "canonical_names": [
        "Value proposition",
        "Benefits",
        "ROI",
        "Impact"
      ],
      "non_title_signals": [
        "save time",
        "reduce cost",
        "increase revenue",
        "risk reduction",
        "quality improvement",
        "before/after metrics"
      ],
      "common_block_roles": [
        "benefit_claim",
        "roi_metric",
        "before_state",
        "after_state",
        "economic_value",
        "proof_point"
      ],
      "investor_question": "Why will customers pay or switch?",
      "rewrite_goal": "Translate capabilities into measurable business value."
    },
    {
      "id": "market",
      "canonical_names": [
        "Market",
        "TAM SAM SOM",
        "Opportunity",
        "Market size"
      ],
      "non_title_signals": [
        "currency totals",
        "TAM/SAM/SOM labels",
        "number of companies/users",
        "market growth CAGR",
        "industry spend",
        "wedge market"
