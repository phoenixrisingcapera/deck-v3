      "common_block_roles": [
        "tam",
        "sam",
        "som",
        "market_segment",
        "market_growth",
        "source",
        "bottom_up_assumption"
      ],
      "investor_question": "Can this become a venture-scale business?",
      "rewrite_goal": "Make market sizing credible, bottom-up, and linked to the go-to-market wedge."
    },
    {
      "id": "why_now",
      "canonical_names": [
        "Why now",
        "Timing",
        "Market inflection",
        "Tailwinds"
      ],
      "non_title_signals": [
        "regulatory change",
        "new technology adoption",
        "cost curves",
        "platform shift",
        "budget shift",
        "macro trend",
        "urgent catalyst"
      ],
      "common_block_roles": [
        "timing_catalyst",
        "trend",
        "regulatory_driver",
        "technology_shift",
        "market_readiness",
        "urgency_claim"
      ],
      "investor_question": "Why is this the right time to build this company?",
      "rewrite_goal": "Tie external tailwinds to immediate adoption."
    },
    {
      "id": "business_model",
      "canonical_names": [
        "Business model",
        "Pricing",
        "Revenue model",
        "Monetisation"
      ],
      "non_title_signals": [
        "subscription tiers",
        "usage-based pricing",
        "take rate",
        "gross margin",
        "ACV",
        "pricing table",
