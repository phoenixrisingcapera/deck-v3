    },
    {
      "id": "moat",
      "canonical_names": [
        "Moat",
        "Defensibility",
        "Why we win",
        "Unfair advantage"
      ],
      "non_title_signals": [
        "proprietary data",
        "network effects",
        "workflow lock-in",
        "regulatory advantage",
        "technical edge",
        "distribution advantage"
      ],
      "common_block_roles": [
        "moat_claim",
        "data_asset",
        "technical_advantage",
        "network_effect",
        "switching_cost",
        "distribution_edge"
      ],
      "investor_question": "What compounds over time and becomes hard to copy?",
