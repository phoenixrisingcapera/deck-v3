      "rewrite_goal": "Clarify who pays, how much, when, and why pricing can expand."
    },
    {
      "id": "go_to_market",
      "canonical_names": [
        "Go-to-market",
        "GTM",
        "Distribution",
        "Sales motion"
      ],
      "non_title_signals": [
        "channels",
        "sales cycle",
        "ICP",
        "pipeline",
        "partnerships",
        "community-led growth",
        "land and expand"
