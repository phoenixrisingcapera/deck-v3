{
  "audience_id": "growth_equity",
  "primary_question": "Can this scale efficiently with lower execution risk?",
  "cares_about": [
    "predictable revenue",
    "gross margin",
    "efficiency",
    "leadership depth",
    "market share capture"
  ],
  "red_flags": [
    "high burn with weak growth",
    "messy accounting",
    "customer concentration"
  ],
  "preferred_evidence": [
    "audited or clean financials",
    "retention cohorts",
    "sales efficiency",
    "board reporting"
  ],
  "output_adaptation_rules": {
    "tone": "evidence-led, concise, commercially credible",
    "must_surface": [
      "why now",
      "why this team",
      "why this market",
      "what could kill it"
    ],
    "avoid": [
      "unsupported hype",
      "generic AI claims",
      "inflated TAM without method"
    ]
  }
}