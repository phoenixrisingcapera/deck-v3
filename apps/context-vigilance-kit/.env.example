# context-vigilance-kit — environment template
#
# Copy to .env (gitignored) and fill in. Only the Graphiti path needs any of
# this; the Chroma ingesters run with no configuration at all.
#
#     cp .env.example .env

# ---------------------------------------------------------------------------
# REQUIRED — Anthropic, for Graphiti entity/edge extraction
# ---------------------------------------------------------------------------
# Graphiti needs a raw API key. It cannot borrow Claude Code's session auth —
# graphiti-core talks to the Anthropic SDK directly.
#   https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Extraction model — the right tier for high-volume structured extraction.
# Use the DATED id, not the `-latest` alias: graphiti-core defaults to
# `claude-haiku-4-5-latest`, which 404s on every call.
GRAPHITI_LLM_MODEL=claude-haiku-4-5-20251001
GRAPHITI_LLM_SMALL_MODEL=claude-haiku-4-5-20251001

# ---------------------------------------------------------------------------
# Embeddings — local, via Ollama's OpenAI-compatible endpoint
# ---------------------------------------------------------------------------
# graphiti-core 0.29.0 has no sentence-transformers embedder (only openai,
# azure_openai, gemini, voyage), so local embeddings go through Ollama:
#
#     ollama pull all-minilm
#     ollama serve
#
# all-minilm is 384-dim and the same MiniLM family the Chroma collections
# already use, which keeps the two indexes comparable.
GRAPHITI_EMBED_BASE_URL=http://localhost:11434/v1
GRAPHITI_EMBED_MODEL=all-minilm
GRAPHITI_EMBED_API_KEY=ollama
EMBEDDING_DIM=384

# Reranking. "passthrough" needs no API key and no model download; RRF and MMR
# search recipes don't use a cross-encoder anyway. Set to "bge" for real local
# reranking (pulls torch + a ~2.5GB model, and needs sentence-transformers).
GRAPHITI_CROSS_ENCODER=passthrough

# ---------------------------------------------------------------------------
# Neo4j — matches docker-compose.graphiti.yml
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=losslessgraph

# Concurrent LLM operations during ingest. Graphiti's own default is 10;
# lower it if you hit Anthropic 429s, raise it if ingest feels slow and your
# rate limits allow.
SEMAPHORE_LIMIT=8
