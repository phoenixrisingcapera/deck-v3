---
import BaseLayout from '@layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="404 — context not found" description="No context here. Try the corpus.">
  <main class="four">
    <div class="container-narrow four__inner">
      <p class="four__code mono">404</p>
      <h1 class="four__title">No context found at this path.</h1>
      <p class="four__quip mono">
        <span class="four__caret">▎</span> the agent guessed.
      </p>
      <p class="four__lede">
        That's the whole problem this site is about — agents missing context.
        You probably want one of these instead.
      </p>
      <div class="four__ctas">
        <a class="btn" href={base}>Home</a>
        <a class="btn" href={`${base}corpus/`}>Corpus</a>
        <a class="btn" href={`${base}search/`}>Search</a>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .four {
    padding: var(--space-24) 0;
  }
  .four__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }
  .four__code {
    font-size: clamp(4rem, 10vw, 7rem);
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
    letter-spacing: -0.04em;
  }
  .four__title {
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    margin: 0;
    letter-spacing: -0.025em;
  }
  .four__quip {
    color: var(--color-text-dim);
    font-size: 0.95rem;
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
  }
  .four__caret {
    color: var(--color-accent);
    animation: caret-blink-404 1.1s steps(1, end) infinite;
  }
  @keyframes caret-blink-404 {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  .four__lede {
    color: var(--color-text-soft);
    font-size: 1.02rem;
    line-height: 1.6;
    max-width: 60ch;
    margin: var(--space-4) 0;
  }
  .four__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
</style>
