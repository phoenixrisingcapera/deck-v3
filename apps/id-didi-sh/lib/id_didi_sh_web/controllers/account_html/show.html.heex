<% lab = "font-family: ui-monospace, monospace; font-size: 0.68rem; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.5;" %>
<% inp =
  "width: 100%; padding: 0.5rem 0.7rem; font-size: 0.9rem; border-radius: 6px; border: 1px solid rgba(128,128,128,0.4); background: transparent; color: inherit;" %>
<% btn =
  "padding: 0.5rem 1.1rem; font-size: 0.85rem; font-weight: 600; border-radius: 6px; border: 1px solid #1f9a63; background: #4ecf95; color: #06110b; cursor: pointer;" %>
<% row = "display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; margin-top: 0.6rem;" %>

<div style="max-width: 40rem; margin: 6vh auto 5rem; padding: 0 1.5rem; font-family: ui-sans-serif, system-ui;">
  <p style={lab}>didi.sh · your credential</p>
  <h1 style="font-size: 1.5rem; margin-top: 0.75rem;">Account</h1>

  <%= if info = Phoenix.Flash.get(@flash, :info) do %>
    <p style="margin-top: 1rem; padding: 0.6rem 0.9rem; border-radius: 6px; background: rgba(78,207,149,0.15); font-size: 0.88rem;">
      {info}
    </p>
  <% end %>
  <%= if err = Phoenix.Flash.get(@flash, :error) do %>
    <p style="margin-top: 1rem; padding: 0.6rem 0.9rem; border-radius: 6px; background: rgba(180,85,45,0.18); font-size: 0.88rem;">
      {err}
    </p>
  <% end %>

  <!-- Identity ------------------------------------------------------------->
  <section style="margin-top: 2rem;">
    <p style={lab}>Identity</p>
    <form action="/account/profile" method="post" style="margin-top: 0.6rem;">
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <div style="display: grid; grid-template-columns: 7rem 1fr; gap: 0.55rem 1rem; align-items: center; font-size: 0.9rem;">
        <label style="opacity: 0.6;">Name</label>
        <input type="text" name="name" value={@user.name} placeholder="Your name" style={inp} />
        <label style="opacity: 0.6;">Handle</label>
        <input type="text" name="handle" value={@user.handle} placeholder="michael" style={inp} />
      </div>
      <div style={row}><button type="submit" style={btn}>Save profile</button></div>
    </form>

    <dl style="margin: 1.2rem 0 0; display: grid; grid-template-columns: 7rem 1fr; gap: 0.4rem 1rem; font-size: 0.9rem;">
      <dt style="opacity: 0.6;">Email</dt>
      <dd style="margin: 0;"><strong>{@user.primary_email}</strong></dd>
      <dt style="opacity: 0.6;">didi_id</dt>
      <dd style="margin: 0; font-family: ui-monospace, monospace; font-size: 0.76rem; word-break: break-all;">
        {@user.didi_id}
      </dd>
    </dl>
  </section>

  <!-- Linked emails -------------------------------------------------------->
  <section style="margin-top: 2rem;">
    <p style={lab}>Linked emails · {length(@alt_emails)}</p>
    <%= if @alt_emails != [] do %>
      <ul style="margin: 0.6rem 0 0; padding: 0; list-style: none; font-size: 0.9rem;">
        <%= for e <- @alt_emails do %>
          <li style="padding: 0.35rem 0; border-bottom: 1px solid rgba(128,128,128,0.15);">{e}</li>
        <% end %>
      </ul>
    <% end %>
    <form action="/account/emails" method="post" style={row}>
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <input
        type="email"
        name="email"
        placeholder="another@address.com"
        required
        style={inp <> "flex: 1; min-width: 14rem;"}
      />
      <button type="submit" style={btn}>Link email</button>
    </form>
    <p style="margin-top: 0.5rem; font-size: 0.75rem; opacity: 0.55;">
      An address is <em>added</em>, never edited in place — editing one would
      silently move an identity.
    </p>
  </section>

  <!-- Entities ------------------------------------------------------------->
  <section style="margin-top: 2.2rem;">
    <p style={lab}>Entities · {length(@entities)}</p>

    <%= if @entities == [] do %>
      <p style="margin-top: 0.6rem; font-size: 0.88rem; opacity: 0.7;">
        None yet. Membership is granted, never inferred from an email domain — so
        an empty list means nobody has added you, not that something failed.
      </p>
    <% end %>

    <%= for e <- @entities do %>
      <div style="margin-top: 0.9rem; padding: 0.7rem 0.85rem; border: 1px solid rgba(128,128,128,0.22); border-radius: 8px;">
        <div style="display: flex; align-items: baseline; gap: 0.6rem; flex-wrap: wrap;">
          <span style="font-family: ui-monospace, monospace; font-size: 0.72rem; opacity: 0.55;">
            {e.role}
          </span>
          <strong>{e.name || e.id}</strong>
          <span style="font-family: ui-monospace, monospace; font-size: 0.73rem; opacity: 0.5;">
            [{e.slug || "—"}] · {e.kind || "?"} · via {e.via}
          </span>
        </div>

        <%= if e.admin? do %>
          <form action={"/account/entities/#{e.id}/members"} method="post" style={row}>
            <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
            <input
              type="email"
              name="email"
              placeholder="person@company.com"
              required
              style={inp <> "flex: 1; min-width: 12rem;"}
            />
            <select name="role" style={inp <> "width: auto;"}>
              <%= for r <- @roles do %>
                <option value={r} selected={r == "viewer"}>{r}</option>
              <% end %>
            </select>
            <button type="submit" style={btn}>Add</button>
          </form>
          <p style="margin-top: 0.4rem; font-size: 0.73rem; opacity: 0.5;">
            Unknown address? They get an invite — granting access to somebody who
            has not signed in yet is the common case, not the exception.
          </p>
        <% end %>
      </div>
    <% end %>

    <!-- create -->
    <form
      action="/account/entities"
      method="post"
      style="margin-top: 1.2rem; padding: 0.8rem 0.9rem; border: 1px dashed rgba(128,128,128,0.35); border-radius: 8px;"
    >
      <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
      <p style={lab}>New entity</p>
      <div style={row}>
        <input type="text" name="name" placeholder="Palmer AI" required style={inp <> "flex: 1; min-width: 10rem;"} />
        <input type="text" name="slug" placeholder="palmer-ai" required style={inp <> "flex: 1; min-width: 9rem;"} />
        <select name="kind" style={inp <> "width: auto;"}>
          <%= for k <- @kinds do %>
            <option value={k} selected={k == "organization"}>{k}</option>
          <% end %>
        </select>
        <button type="submit" style={btn}>Create</button>
      </div>
      <p style="margin-top: 0.5rem; font-size: 0.73rem; opacity: 0.55;">
        The handle is the identity. Kind is a label and carries no structure —
        parent/child only exists when you chain them in a reference.
      </p>
    </form>
  </section>

  <!-- Legacy orgs ---------------------------------------------------------->
  <%= if @legacy_orgs != [] do %>
    <section style="margin-top: 2.2rem;">
      <p style={lab}>Organizations (legacy) · {length(@legacy_orgs)}</p>
      <p style="margin-top: 0.5rem; font-size: 0.75rem; opacity: 0.55;">
        The older org-wide membership table. Shown separately because both tables
        exist — picking one silently is how a reader concludes the other is empty.
      </p>
      <ul style="margin: 0.6rem 0 0; padding: 0; list-style: none; font-size: 0.9rem;">
        <%= for o <- @legacy_orgs do %>
          <li style="display: flex; gap: 0.7rem; padding: 0.35rem 0; border-bottom: 1px solid rgba(128,128,128,0.15);">
            <span style="font-family: ui-monospace, monospace; font-size: 0.72rem; opacity: 0.55; min-width: 4.5rem;">
              {o.role}
            </span>
            <span>
              <strong>{o.name || o.id}</strong>
              <%= if o.slug do %>
                <span style="font-family: ui-monospace, monospace; font-size: 0.73rem; opacity: 0.5;">
                  &nbsp;[{o.slug}]
                </span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <!-- Keys ----------------------------------------------------------------->
  <section style="margin-top: 2.2rem;">
    <p style={lab}>Keys</p>
    <p style="margin-top: 0.6rem; font-size: 0.9rem;">
      <span style="color: #4ecf95;">▣</span> Your session token verified against the
      signing key just now — the same check a consumer service performs locally.
    </p>
    <div style={row}>
      <a href="/keys" style={btn <> "text-decoration: none; display: inline-block;"}>
        Manage credentials →
      </a>
    </div>
    <p style="margin-top: 0.6rem; font-size: 0.78rem; opacity: 0.65;">
      Paste a key, lend it to entities, watch usage, take it back. Public keys:
      <a href={@jwks_url}>{@jwks_url}</a>
    </p>
  </section>

  <!-- Session -------------------------------------------------------------->
  <section style="margin-top: 2.2rem;">
    <p style={lab}>Session</p>
    <dl style="margin: 0.6rem 0 0; display: grid; grid-template-columns: 7rem 1fr; gap: 0.4rem 1rem; font-size: 0.88rem;">
      <dt style="opacity: 0.6;">Expires</dt>
      <dd style="margin: 0;">{@session.expires_at}</dd>
      <dt style="opacity: 0.6;">Session id</dt>
      <dd style="margin: 0; font-family: ui-monospace, monospace; font-size: 0.76rem; word-break: break-all;">
        {@session.id}
      </dd>
    </dl>
  </section>

  <p style="margin-top: 2.5rem; font-size: 0.78rem; opacity: 0.5;">
    Every action here calls the same context function the JSON API calls — one
    rule, two surfaces. <a href="https://didi.sh/">didi.sh</a>
  </p>
</div>
