<div style="max-width: 26rem; margin: 14vh auto 0; padding: 0 1.5rem; font-family: ui-sans-serif, system-ui; text-align: center;">
  <p style="font-family: ui-monospace, monospace; font-size: 0.7rem; letter-spacing: 0.2em; text-transform: uppercase; opacity: 0.6;">
    didi.sh · one credential
  </p>
  <h1 style="font-size: 1.5rem; margin-top: 0.75rem;">Sign in to didi.sh</h1>
  <p style="margin-top: 0.75rem; opacity: 0.75;">
    No password. We email you a single-use link.
  </p>

  <%= if @error do %>
    <p style="margin-top: 1rem; color: #b4552d;">{@error}</p>
  <% end %>

  <form action="/auth" method="post" style="margin-top: 1.5rem;">
    <input type="hidden" name="_csrf_token" value={Plug.CSRFProtection.get_csrf_token()} />
    <input
      type="email"
      name="email"
      value={@email}
      required
      autofocus
      autocomplete="email"
      placeholder="you@example.com"
      style="width: 100%; padding: 0.7rem 0.9rem; font-size: 1rem; border-radius: 6px; border: 1px solid #4a4a4a; background: transparent; color: inherit;"
    />
    <button
      type="submit"
      style="margin-top: 0.75rem; width: 100%; padding: 0.7rem 1.6rem; font-size: 1rem; font-weight: 600; border-radius: 6px; border: 1px solid #1f9a63; background: #4ecf95; color: #06110b; cursor: pointer;"
    >
      Email me a link →
    </button>
  </form>

  <p style="margin-top: 1.25rem; font-size: 0.75rem; opacity: 0.5;">
    didi.sh is invite only. If you have not been invited, the link will not arrive.
  </p>
</div>
