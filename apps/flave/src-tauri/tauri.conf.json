{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "flave",
  "version": "0.0.0",
  "identifier": "group.lossless.flave",
  "build": {
    "frontendDist": "../apps/editor/dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "pnpm --filter @flave/editor dev",
    "beforeBuildCommand": "pnpm --filter @flave/editor build"
  },
  "app": {
    "windows": [
      {
        "title": "flave",
        "width": 1500,
        "height": 950,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
