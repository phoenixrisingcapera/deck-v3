---
/**
 * AgenticHero — the opening act.
 *
 * The argument before the thesis: every incumbent document format was designed
 * when the only author was a human with a mouse, so the file could be opaque.
 * Agents are near-perfect and instant in exactly the languages a modern
 * document actually needs. The incumbents flip past in a plate slot to make
 * the point without a paragraph.
 *
 * StrataHero follows and carries the "keeps its workings" thesis. Order is
 * deliberate: why a new file, then what this one does.
 */

const FLUENT = ['HTML', 'CSS', 'Markdown', 'JSON', 'CSV', 'SVG'];

// The incumbents. Order is roughly by how often the objection gets raised.
// The first entry is duplicated at the end so the loop closes seamlessly.
const INCUMBENTS = ['Keynote', 'PowerPoint', 'Pages', 'Word', 'InDesign'];
const REEL = [...INCUMBENTS, INCUMBENTS[0]];
---

<section class="opener">
  <span class="regmark" style="top: 0; left: 0;"></span>
  <span class="regmark" style="top: 0; right: 0;"></span>

  <div class="container">
    <p class="eyebrow opener__eyebrow">
      <span class="opener__dot" aria-hidden="true"></span>
      flave · an open document format
    </p>

    <h1 class="opener__title">
      <span class="misreg" data-text="A new kind of file">A new kind of file</span><br />
      <span class="misreg" data-text="for the Agentic Era.">for the Agentic Era.</span>
    </h1>

    <p class="opener__fluent">
      Agents are near-perfect and lightspeed in
      <span class="fluent">
        {FLUENT.map((f) => <span class="fluent__tok">{f}</span>)}
      </span>
    </p>

    <p class="opener__ask">
      So why are we still using
      <span class="flip" aria-hidden="true">
        <span class="flip__reel">
          {REEL.map((n) => <span class="flip__item">{n}</span>)}
        </span>
      </span>
      <span class="sr-only">Keynote, PowerPoint, Pages, Word, or InDesign</span>?
    </p>

    <p class="opener__kicker">
      Just tell the agent what you want. <strong>Done, blazing fast.</strong>
    </p>

    <div class="opener__actions">
      <a class="btn btn--primary" href={`${import.meta.env.BASE_URL}context-v/`}>Read the spec</a>
      <a class="btn" href="https://github.com/lossless-group/flave" target="_blank" rel="noopener">
        github ↗
      </a>
    </div>
  </div>
</section>

<style>
  .opener {
    position: relative;
    padding: var(--space-16) 0 var(--space-12);
  }

  .opener__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .opener__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-accent);
    flex: none;
  }

  .opener__title {
    margin-top: var(--space-4);
    font-size: clamp(2.6rem, 7.5vw, var(--text-5xl));
    max-width: 18ch;
  }

  /* ── The fluency line — format names as press-plate tokens ─────── */

  .opener__fluent {
    margin-top: var(--space-8);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
    max-width: 68ch;
  }

  .fluent {
    display: inline-flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-left: var(--space-1);
    vertical-align: baseline;
  }
  .fluent__tok {
    font-family: var(--font__mono);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-mono);
    color: var(--color-text);
    background: var(--color-bg-soft);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    padding: 1px var(--space-2);
  }

  /* ── The question, with the incumbents flipping through a slot ──── */

  .opener__ask {
    --flip-h: 1.15em;
    margin-top: var(--space-6);
    font-family: var(--font__display);
    font-weight: 600;
    letter-spacing: var(--tracking-display);
    font-size: clamp(1.5rem, 3.6vw, var(--text-3xl));
    line-height: 1.3;
  }

  .flip {
    display: inline-block;
    height: var(--flip-h);
    overflow: hidden;
    vertical-align: bottom;
    /* the slot: a plate window the names rotate behind */
    border-bottom: 2px solid var(--color-accent);
    margin-inline: 0.15em;
  }

  .flip__reel {
    display: flex;
    flex-direction: column;
    animation: flip-reel 13s cubic-bezier(0.7, 0, 0.2, 1) infinite;
  }

  .flip__item {
    height: var(--flip-h);
    line-height: var(--flip-h);
    color: var(--color-accent);
    white-space: nowrap;
  }

  @keyframes flip-reel {
    0%,
    14% {
      transform: translateY(0);
    }
    18%,
    32% {
      transform: translateY(calc(var(--flip-h) * -1));
    }
    36%,
    50% {
      transform: translateY(calc(var(--flip-h) * -2));
    }
    54%,
    68% {
      transform: translateY(calc(var(--flip-h) * -3));
    }
    72%,
    86% {
      transform: translateY(calc(var(--flip-h) * -4));
    }
    90%,
    100% {
      transform: translateY(calc(var(--flip-h) * -5));
    }
  }

  /* A moving word is the one thing on this page that must hold still for
     anyone who asked it to. Pin to the first name and drop the animation. */
  @media (prefers-reduced-motion: reduce) {
    .flip__reel {
      animation: none;
      transform: translateY(0);
    }
  }

  .opener__kicker {
    margin-top: var(--space-6);
    font-size: var(--text-lg);
    color: var(--color-text-soft);
    max-width: 60ch;
  }
  .opener__kicker strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .opener__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-8);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
