---
import { STATIC_SEO, DEFAULT_OG } from '@lib/seo';

interface Props {
  title: string;
  description?: string;
  /**
   * Either a fully-qualified URL (e.g. ImageKit) or a path under /public/.
   * Defaults pulled from `DEFAULT_OG` in seo.ts. Pages can swap to any of
   * the named entries in `OG_IMAGES` (banner / wide / square / portrait).
   */
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogImageType?: string;
  ogImageAlt?: string;
  ogType?: string;
  noindex?: boolean;
  canonical?: string;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

const {
  title,
  description = STATIC_SEO.root.description,
  ogImage = DEFAULT_OG?.url,
  ogImageWidth = DEFAULT_OG?.width,
  ogImageHeight = DEFAULT_OG?.height,
  ogImageType = DEFAULT_OG?.type,
  ogImageAlt = DEFAULT_OG?.alt,
  ogType = 'website',
  noindex = false,
  canonical,
  publishedTime,
  modifiedTime,
  author,
  tags,
} = Astro.props;

const fullTitle = title.endsWith(STATIC_SEO.titleSuffix)
  ? title
  : `${title}${STATIC_SEO.titleSuffix}`;

const base = import.meta.env.BASE_URL;
const site = Astro.site?.toString().replace(/\/$/, '') ?? '';
// No OG image is generated for flave yet (see @lib/seo). Emitting a broken
// or placeholder image is worse than emitting none — an absent og:image
// unfurls as a clean text card, a 404 unfurls as a grey box. So every
// image-bearing tag below is conditional on `ogImageUrl` being present.
const ogImageUrl = !ogImage
  ? undefined
  : ogImage.startsWith('http')
    ? ogImage
    : `${site}${base}${ogImage}`.replace(/([^:])\/\//g, '$1/');
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).toString();
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex,nofollow" />}
<link rel="canonical" href={canonicalUrl} />

<meta property="og:type" content={ogType} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:site_name" content={STATIC_SEO.siteName} />
{ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
{ogImageUrl && ogImageWidth && <meta property="og:image:width" content={String(ogImageWidth)} />}
{ogImageUrl && ogImageHeight && <meta property="og:image:height" content={String(ogImageHeight)} />}
{ogImageUrl && ogImageType && <meta property="og:image:type" content={ogImageType} />}
{ogImageUrl && ogImageAlt && <meta property="og:image:alt" content={ogImageAlt} />}

<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
{ogImageUrl && ogImageAlt && <meta name="twitter:image:alt" content={ogImageAlt} />}

{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
{author && <meta property="article:author" content={author} />}
{tags?.map((tag) => <meta property="article:tag" content={tag} />)}
