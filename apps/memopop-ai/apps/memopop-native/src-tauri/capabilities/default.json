{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and the quick-look source viewer",
  "windows": [
    "main",
    "quick-look"
  ],
  "permissions": [
    "core:default",
    "core:webview:allow-create-webview-window",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "opener:default",
    "shell:default",
    "dialog:default",
    "store:default",
    "fs:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        { "path": "**", "app": true }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        { "path": "**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "obsidian:" },
        { "url": "https:" },
        { "url": "http:" }
      ]
    }
  ]
}